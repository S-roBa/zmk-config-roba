#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_MOUSE_POINTING_SCRL_VAL 100

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <11 12>;
    scroll-layers = <14>;

    arrows {
        layers = <15>;
        bindings =
            <&kp RIGHT_ARROW>,
            <&kp LEFT_ARROW>,
            <&kp UP_ARROW>,
            <&kp DOWN_ARROW>;

        tick = <10>;
        wait-ms = <5>;
        tap-ms = <5>;
    };
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        to_layer_1: to_layer_1 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 1 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_1";
        };

        IMEON_Lkakko: IMEON_kakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LANGUAGE_2>,
                <&macro_wait_time 30>,
                <&kp LEFT_BRACKET>;

            label = "IMEON_KAKKO";
        };

        IMEON_Rkakko: IMEON_Rkakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LANGUAGE_2>,
                <&macro_wait_time 30>,
                <&kp RIGHT_BRACKET>;

            label = "IMEON_RKAKKO";
        };

        IMEOFF_LBKT: IMEOFF_Lkakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LANGUAGE_1>,
                <&macro_wait_time 30>,
                <&kp LEFT_BRACKET>;

            label = "IMEOFF_LKAKKO";
        };

        IMEOFF_RBKT: IMEOFF_Rkakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LANGUAGE_1>,
                <&macro_wait_time 30>,
                <&kp RIGHT_BRACKET>;

            label = "IMEOFF_RKAKKO";
        };

        IMEOFF_LPAR: IMEOFF_LPAR {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG1>, <&macro_wait_time 30>, <&kp LPAR>;

            label = "IMEOFF_LPAR";
        };

        IMEOFF_RPAR: IMEOFF_RPAR {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG1>, <&macro_wait_time 30>, <&kp RPAR>;

            label = "IMEOFF_RPAR";
        };

        IMEOFF_LBRC: IMEOFF_LBRC {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG1>, <&macro_wait_time 30>, <&kp LBRC>;

            label = "IMEOFF_LBRC";
        };

        IMEOFF_RBRC: IMEOFF_RBRC {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG1>, <&macro_wait_time 30>, <&kp RBRC>;

            label = "IMEOFF_RBRC";
        };

        IMEOFF_LessThan: IMEOFF_LessThan {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG1>, <&macro_wait_time 30>, <&kp LESS_THAN>;

            label = "IMEOFF_LESSTHAN";
        };

        IMEOFF_Percent: IMEOFF_Percent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG1>, <&macro_wait_time 30>, <&kp PERCENT>;

            label = "IMEOFF_PERCENT";
        };

        IMEOFF_Caret: IMEOFF_Caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG1>, <&macro_wait_time 30>, <&kp CARET>;

            label = "IMEOFF_CARET";
        };

        IMEOFF_MoreThan: IMEOFF_MoreThan {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG1>, <&macro_wait_time 30>, <&kp GREATER_THAN>;

            label = "IMEOFF_MORETHAN";
        };

        Windows1: Windows1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 0>;
            label = "WINDOWS1";
        };

        MacOS: MacOS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 1>;
            label = "MACOS";
        };

        iPhone: iPhone {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &to 1>;
            label = "IPHONE";
        };

        iPad: iPad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &to 1>;
            label = "IPAD";
        };

        Windows2: Windows2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4 &to 0>;
            label = "WINDOWS2";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        lt_to_layer_1: lt_to_layer_1 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_1";
            bindings = <&mo>, <&to_layer_1>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        YTMute: YTMute {
            compatible = "zmk,behavior-mod-morph";
            label = "YTMUTE";
            bindings = <&kp DOWN_ARROW>, <&kp M>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        YTSpeedMinus: YTSpeedMinus {
            compatible = "zmk,behavior-mod-morph";
            label = "YTSPEEDMINUS";
            bindings = <&kp LA(COMMA)>, <&kp COMMA>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        YTSpeedPlus: YTSpeedPlus {
            compatible = "zmk,behavior-mod-morph";
            label = "YTSPEEDPLUS";
            bindings = <&kp RA(PERIOD)>, <&kp PERIOD>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        YTBack: YTBack {
            compatible = "zmk,behavior-mod-morph";
            label = "YTBACK";
            bindings = <&kp LEFT_ARROW>, <&kp J>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        YTForward: YTForward {
            compatible = "zmk,behavior-mod-morph";
            label = "YTFORWARD";
            bindings = <&kp RIGHT_ARROW>, <&kp L>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        F1toF11: F1toF11 {
            compatible = "zmk,behavior-mod-morph";
            label = "F1TOF11";
            bindings = <&kp F1>, <&kp F11>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        F2toF12: F2toF12 {
            compatible = "zmk,behavior-mod-morph";
            label = "F2TOF12";
            bindings = <&kp F2>, <&kp F12>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        F3toF13: F3toF13 {
            compatible = "zmk,behavior-mod-morph";
            label = "F3TOF13";
            bindings = <&kp F3>, <&kp F13>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        F4toF14: F4toF14 {
            compatible = "zmk,behavior-mod-morph";
            label = "F4TOF14";
            bindings = <&kp F4>, <&kp F14>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        F5toF15: F5toF15 {
            compatible = "zmk,behavior-mod-morph";
            label = "F5TOF15";
            bindings = <&kp F5>, <&kp F15>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        F6toF16: F6toF16 {
            compatible = "zmk,behavior-mod-morph";
            label = "F6TOF16";
            bindings = <&kp F6>, <&kp F16>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        F7toF17: F7toF17 {
            compatible = "zmk,behavior-mod-morph";
            label = "F7TOF17";
            bindings = <&kp F7>, <&kp F17>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        F8toF18: F8toF18 {
            compatible = "zmk,behavior-mod-morph";
            label = "F8TOF18";
            bindings = <&kp F8>, <&kp F18>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        F9toF19: F9toF19 {
            compatible = "zmk,behavior-mod-morph";
            label = "F9TOF19";
            bindings = <&kp F9>, <&kp F19>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            mods = <MOD_LSFT>;
        };

        bspc_mo: backspace_or_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&bspc_del>;
        };

        mb_mo: mb_or_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&mkp>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W         &kp E         &kp R        &kp T                                                  &kp Y         &kp U  &kp I         &kp O     &kp P
&kp A      &kp S         &kp D         &kp F        &kp G                 &mkp MB1           &mt LALT F20  &kp H         &kp J  &lt 14 K      &lt 13 L  &lt 11 MINUS
&kp Z      &kp X         &kp C         &kp V        &kp B                 &mt LCTRL TAB      &kp B         &kp N         &kp M  &lt 15 COMMA  &kp DOT   &kp SLASH
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &lt 7 LANG1  &mt LEFT_SHIFT SPACE  &lt 13 LANG2       &lt 3 ENTER   &bspc_mo 5 0                                 &mo 17
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        APPLE-DEFAULT {
            bindings = <
&kp Q     &kp W      &kp E         &kp R        &kp T                                                 &kp Y         &kp U  &kp I         &kp O     &kp P
&kp A     &kp S      &kp D         &kp F        &kp G                 &mkp MB1          &mt LALT F20  &kp H         &kp J  &lt 14 K      &lt 13 L  &lt 12 MINUS
&kp Z     &kp X      &kp C         &kp V        &kp B                 &mt LGUI TAB      &kp B         &kp N         &kp M  &lt 15 COMMA  &kp DOT   &kp SLASH
&kp LGUI  &kp LCTRL  &kp LEFT_ALT  &lt 7 LANG1  &mt LEFT_SHIFT SPACE  &lt 2 LANG2       &lt 4 ENTER   &bspc_mo 6 0                                 &mo 17
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        APPLE {
            bindings = <
&none  &none  &none  &none  &none                           &kp LG(NUMBER_1)  &kp LG(LA(UP_ARROW))        &kp LA(LC(LG(NUMBER_2)))  &kp LG(LA(RIGHT_ARROW))      &none
&none  &none  &none  &none  &none  &none      &kp GLOBE     &kp LG(NUMBER_2)  &kp LG(LA(LC(LEFT_ARROW)))  &kp LG(LC(F))             &kp LG(LA(LC(RIGHT_ARROW)))  &none
&none  &none  &none  &none  &none  &none      &kp UP_ARROW  &kp LG(NUMBER_3)  &kp LG(LA(LEFT_ARROW))      &kp LA(LC(LG(NUMBER_4)))  &kp LG(LA(DOWN_ARROW))       &none
&none  &none  &none  &none  &none  &none      &none         &none                                                                                                &none
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        FUNCTIONandCODE {
            bindings = <
&none      &F7toF17  &F8toF18  &F9toF19  &kp F12                                   &none          &none          &none  &kp LS(LC(O))  &none
&none      &F4toF14  &F5toF15  &F6toF16  &kp F11        &trans      &trans         &kp LC(H)      &kp LS(LC(F))  &none  &none          &none
&kp RSHFT  &F1toF11  &F2toF12  &F3toF13  &kp F10        &trans      &kp LC(SPACE)  &kp LS(LC(R))  &none          &none  &none          &none
&trans     &trans    &trans    &none     &mt LSHFT F20  &none       &trans         &none                                               &none
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        FandCforMAC-mada {
            bindings = <
&none      &F7toF17  &F8toF18  &F9toF19  &kp F12                                   &none          &none          &none  &kp LS(LC(O))  &none
&none      &F4toF14  &F5toF15  &F6toF16  &kp F11        &trans      &trans         &kp LC(H)      &kp LS(LC(F))  &none  &none          &none
&kp RSHFT  &F1toF11  &F2toF12  &F3toF13  &kp F10        &trans      &kp LC(SPACE)  &kp LS(LC(R))  &none          &none  &none          &none
&trans     &trans    &trans    &none     &mt LSHFT F20  &none       &trans         &none                                               &none
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        NUMandARROW {
            bindings = <
&IMEOFF_Percent  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &IMEOFF_Caret                                        &kp LG(LC(LEFT))  &kp LC(PG_UP)    &kp UP_ARROW    &kp LC(PG_DN)   &kp LG(LC(RIGHT))
&kp KP_SLASH     &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS   &trans                &trans          &kp HOME          &kp LEFT_ARROW   &kp DOWN_ARROW  &mt RALT RIGHT  &mt LGUI END
&kp KP_ASTERISK  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_PLUS    &IMEOFF_LessThan      &kp LC(W)       &kp LC(LS(T))     &kp LS(LA(TAB))  &kp LG(TAB)     &kp LA(TAB)     &kp LC(T)
&trans           &kp KP_N0        &kp KP_DOT       &kp KP_EQUAL     &trans         &none                 &kp KP_NUMLOCK  &trans                                                             &none
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        NandAforMAC {
            bindings = <
&IMEOFF_Percent  &kp N7        &kp N8        &kp N9        &IMEOFF_Caret                                        &kp LC(LEFT)   &kp LG(LS(TAB))  &kp UP_ARROW      &kp LG(TAB)      &kp LC(RIGHT)
&kp KP_SLASH     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp KP_MINUS   &trans                &trans          &kp HOME       &kp LEFT_ARROW   &kp DOWN_ARROW    &kp RIGHT_ARROW  &mt LG(LCTRL) END
&kp KP_ASTERISK  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_PLUS    &IMEOFF_LessThan      &kp LG(W)       &kp LS(LG(T))  &kp LS(LA(TAB))  &kp LC(UP_ARROW)  &kp LA(TAB)      &kp LG(T)
&trans           &kp N0        &kp KP_DOT    &kp KP_EQUAL  &trans         &none                 &kp KP_NUMLOCK  &trans                                                             &none
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        SYMBOL {
            bindings = <
&kp ESC    &kp AMPERSAND       &none          &none       &none                       &kp SQT        &IMEOFF_LBRC   &IMEOFF_RBRC   &IMEOFF_LBKT      &IMEOFF_RBKT
&kp SLASH  &mt LC(LSHFT) PIPE  &kp BACKSLASH  &kp DOLLAR  &none   &trans      &trans  &kp SEMICOLON  &IMEOFF_LPAR   &IMEOFF_RPAR   &IMEOFF_LessThan  &IMEOFF_MoreThan
&kp LSHFT  &kp EXCLAMATION     &kp AT_SIGN    &kp HASH    &none   &trans      &none   &kp GRAVE      &IMEON_Lkakko  &IMEON_Rkakko  &none             &none
&trans     &trans              &trans         &trans      &trans  &none       &none   &kp DELETE                                                     &none
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        YouTube {
            bindings = <
&none  &none  &none  &none  &none                     &kp LC(W)      &kp LC(PG_UP)  &kp UP_ARROW   &kp LC(PAGE_DOWN)  &kp RA(P)
&none  &none  &none  &none  &none  &to 0      &none   &kp LS(LC(T))  &YTBack        &YTMute        &YTForward         &mo 10
&none  &none  &none  &none  &none  &none      &none   &none          &kp C          &YTSpeedMinus  &YTSpeedPlus       &kp RSHFT
&none  &none  &none  &none  &none  &none      &mo 10  &kp SPACE                                                       &none
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        YouTubeforMAC {
            bindings = <
&none  &none  &none  &none  &none                     &kp LG(W)      &kp LC(PG_UP)  &kp UP_ARROW   &kp LC(PAGE_DOWN)  &kp RA(P)
&none  &none  &none  &none  &none  &to 1      &none   &kp LS(LG(T))  &YTBack        &YTMute        &YTForward         &mo 10
&none  &none  &none  &none  &none  &none      &none   &none          &kp C          &YTSpeedMinus  &YTSpeedPlus       &kp RSHFT
&none  &none  &none  &none  &none  &none      &mo 10  &kp SPACE                                                       &none
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        YouTube-Typing {
            bindings = <
&kp Q      &kp W         &kp E         &kp R      &kp T                                           &kp Y      &kp U  &kp I         &kp O     &kp P
&kp A      &kp S         &kp D         &kp F      &kp G                 &mkp MB1       &kp F20    &kp H      &kp J  &lt 14 K      &lt 13 L  &trans
&kp Z      &kp X         &kp C         &kp V      &kp B                 &kp TAB        &kp B      &kp N      &kp M  &lt 15 COMMA  &kp DOT   &kp SLASH
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &kp LANG1  &mt LEFT_SHIFT SPACE  &kp LANG2      &kp ENTER  &bspc_del                                 &mo 17
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&to_layer_0 Q  &to_layer_0 W  &to_layer_0 E  &to_layer_0 R      &to_layer_0 T                                                   &to_layer_0 Y  &mkp MB3      &kp LG(TAB)    &to_layer_0 O        &to_layer_0 P
&to_layer_0 A  &to_layer_0 S  &to_layer_0 D  &to_layer_0 F      &to_layer_0 G  &trans                            &trans         &mkp MB5       &mkp MB1      &mb_mo 14 MB2  &lt_to_layer_0 13 L  &lt_to_layer_0 11 MINUS
&to_layer_0 Z  &to_layer_0 X  &to_layer_0 C  &to_layer_0 V      &to_layer_0 B  &trans                            &to_layer_0 B  &mkp MB4       &lt 15 LC(Z)  &kp LC(Y)      &to_layer_0 PERIOD   &to_layer_0 SLASH
&trans         &trans         &trans         &to_layer_0 LANG1  &trans         &lt_to_layer_0 13 LANGUAGE_2      &trans         &trans                                                           &none
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSEforMAC {
            bindings = <
&to_layer_1 Q  &to_layer_1 W  &to_layer_1 E  &to_layer_1 R      &to_layer_1 T                                                   &to_layer_1 Y  &mkp MB3      &kp LC(UP_ARROW)  &to_layer_1 O        &to_layer_1 P
&to_layer_1 A  &to_layer_1 S  &to_layer_1 D  &to_layer_1 F      &to_layer_1 G  &trans                            &trans         &mkp MB5       &mkp MB1      &mb_mo 14 MB2     &lt_to_layer_1 13 L  &lt_to_layer_1 12 MINUS
&to_layer_1 Z  &to_layer_1 X  &to_layer_1 C  &to_layer_1 V      &to_layer_1 B  &trans                            &to_layer_1 B  &mkp MB4       &lt 15 LG(Z)  &kp LG(LS(Z))     &to_layer_1 PERIOD   &to_layer_1 SLASH
&trans         &trans         &trans         &to_layer_1 LANG1  &trans         &lt_to_layer_1 13 LANGUAGE_2      &trans         &trans                                                              &none
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE_SLOW {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mo 14  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                            &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                            &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        GESTURE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        LogicPro {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &to 1       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Bluetooth {
            bindings = <
&Windows1     &MacOS        &iPhone       &iPad         &Windows2                                  &none  &none          &none  &none   &kp PRINTSCREEN
&to 0         &to 1         &out OUT_TOG  &none         &none         &sys_reset      &bootloader  &none  &none          &none  &to 16  &to 9
